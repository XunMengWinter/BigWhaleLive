LLM_MODE=demo
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
AI_NAME=大肥鱼
TTS_MODE=off
TTS_VOICE=zh-CN-XiaoyiNeural
BILI_MODE=off
BILI_ROOM_ID=9748572
# BILI_MODE=web 使用固定房间的访客连接，不登录账号，也不读取浏览器Cookie。
# 官方弹幕接入说明：docs/bilibili-setup.md。四项就绪后才改为 open_live。
# BILI_APP_ID 是数字项目ID；身份码和密钥仅填本机 .env。
BILI_APP_ID=
BILI_ACCESS_KEY=
BILI_ACCESS_SECRET=
BILI_AUTH_CODE=
LIVE2D_MODEL_URL=
AUTONOMOUS_INTERVAL_SECONDS=15
QUEUE_CAPACITY=100
EVENT_TTL_SECONDS=60
TTS_RATE=+8%
TTS_PITCH=+35Hz
# 可选：Apple Silicon macOS 完成 tools/setup_local_voice.py 后，改 TTS_MODE=qwen_local。
# 本地固定音色为 xiaojing-v1；TTS_VOICE/RATE/PITCH 仅用于 edge 模式。
TTS_LOCAL_PYTHON=.cache/voice-env/bin/python
TTS_LOCAL_MODEL=.cache/models/xiaojing-base
TTS_LOCAL_TIMEOUT_SECONDS=90
